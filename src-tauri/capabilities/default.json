{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability restricted to the main local UI webview",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-shadow",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://true-sota.com/**" },
        { "url": "https://t.me/afk3drp" },
        { "url": "https://github.com/afk3drp-dev/truesota-monitor/releases" },
        { "url": "https://github.com/afk3drp-dev/truesota-monitor/releases/**" }
      ]
    }
  ]
}
